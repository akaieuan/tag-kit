{
  "name": "tag-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Structured tagging primitives for human-in-the-loop annotation workflows. Per-modality scoping, scope-aware agreement scoring, framework-agnostic schema.",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaieuan/tag-kit.git"
  },
  "license": "MIT",
  "author": "Ieuan King",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:publish": "node scripts/publish-smoke.mjs",
    "check:readme": "node scripts/readme-check.mjs",
    "check:zero-dep": "node scripts/zero-dep-check.mjs",
    "api:generate": "node scripts/api-surface.mjs --write",
    "api:check": "node scripts/api-surface.mjs --check",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
