{
  "name": "tag-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Structured tagging primitives for human-in-the-loop annotation workflows. Per-modality scoping, scope-aware agreement scoring, framework-agnostic schema.",
  "repository": {
    "type": "git",
    "url": "https://github.com/akaieuan/tag-kit.git"
  },
  "license": "MIT",
  "author": "Ieuan King",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
